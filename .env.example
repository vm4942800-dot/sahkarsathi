# SahkarSathi Platform — Supabase Backend Configuration Template
# Duplicate this file as .env and fill in your Supabase project credentials.
# Do NOT commit actual keys or production passwords to source control.

# Your Supabase Project API URL (Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=your_supabase_project_url

# Your Supabase Project Anonymous Public Key (Dashboard -> Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
